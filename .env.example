# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Sem estas variáveis, o app usa o banco local simulado.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: força o modo de dados ("supabase" ou "local").
# VITE_DATA_MODE=local

# Opcional (somente modo local): conta de moderação criada automaticamente no navegador.
# VITE_LOCAL_ADMIN_EMAIL=moderacao@experience.demo
# VITE_LOCAL_ADMIN_PASSWORD=Moderacao@2026
